{
  "name": "dsh-provider-fold",
  "version": "1.0.0",
  "description": "Fold the provider groups in the DeepSeek Harness model menu: only your current provider expands, the rest collapse. Install with: dsh plugin add github:CamouflageGe/dsh-provider-fold",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "model-picker",
    "model-menu",
    "collapsible",
    "provider-groups"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CamouflageGe/dsh-provider-fold.git"
  },
  "bugs": {
    "url": "https://github.com/CamouflageGe/dsh-provider-fold/issues"
  },
  "homepage": "https://github.com/CamouflageGe/dsh-provider-fold#readme"
}
