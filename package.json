{
  "name": "dsh-model-picker",
  "version": "1.0.0",
  "description": "Collapsible, searchable model picker for the DeepSeek Harness composer: every model grouped by provider, each group foldable, with multi-word search.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "model-picker",
    "model-selector",
    "composer"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CamouflageGe/dsh-model-picker.git"
  },
  "bugs": {
    "url": "https://github.com/CamouflageGe/dsh-model-picker/issues"
  },
  "homepage": "https://github.com/CamouflageGe/dsh-model-picker#readme"
}
